# Copy these into .env.local (gitignored). Do NOT commit real values.
# Local Next.js: restart `npm run dev` after editing.
# Production (later, with approval): Vercel Project → Settings → Environment Variables

# Required for Buffer connection check / channel listing
BUFFER_ACCESS_TOKEN=paste_your_buffer_api_key_here

# After /admin/marketing →「Buffer接続確認」で classmate0401 の id を確認して設定
BUFFER_CHANNEL_ID=paste_channel_id_for_classmate0401_here

# Keep at 0 until you explicitly allow live scheduling/posts
MARKETING_BUFFER_PUBLISH_ENABLED=0
