# Copy into .env.local (gitignored) or Vercel Environment Variables after operator approval.
# Do NOT commit real keys. Do NOT paste keys into PRs, issues, or chat logs.

# Preferred: dedicated marketing key (can be rotated without touching other features)
# OPENAI_MARKETING_API_KEY=sk-...

# Fallback key name also accepted by the app
# OPENAI_API_KEY=sk-...

# Model (default gpt-4o-mini). Keep mini-class unless quality requires otherwise.
# OPENAI_MARKETING_MODEL=gpt-4o-mini

# Soft cost ceilings (USD). Cron + manual share these counters.
# MARKETING_DAILY_BUDGET_USD=1
# MARKETING_DAILY_RUN_LIMIT=20
# MARKETING_WEEKLY_BUDGET_USD=2
# MARKETING_WEEKLY_RUN_LIMIT=5

# Optional pricing overrides used only for estimated_cost_usd logging
# OPENAI_MARKETING_INPUT_USD_PER_M=0.15
# OPENAI_MARKETING_OUTPUT_USD_PER_M=0.60
