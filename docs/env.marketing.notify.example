# Operator notify channels for marketing ops (gitignored when copied to .env.local).
# Default: all OFF until explicitly enabled on Vercel Production.

# Master switch for evening digest cron (19:00 JST)
# MARKETING_OPS_DIGEST_ENABLED=0

# Email (reuses weekly proposal notify gate + Resend)
# MARKETING_ADMIN_NOTIFY_ENABLED=0
# MARKETING_ADMIN_NOTIFY_EMAIL=you@example.com
# RESEND_API_KEY=
# EMAIL_FROM="Classmate Ops <ops@your-domain>"

# Discord incoming webhook (channel for marketing ops)
# MARKETING_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Shared cron Bearer (already set if daily/weekly cron works)
# MARKETING_CRON_SECRET=
# CRON_SECRET=
